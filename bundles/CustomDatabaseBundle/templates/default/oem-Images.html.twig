{% block content %}
<!-- Advanced Background with Floating Elements -->
<div class="advanced-bg">
    <!-- Animated Floating Shapes -->
    <div class="floating-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
        <div class="shape shape-4"></div>
        <div class="shape shape-5"></div>
        <div class="shape shape-6"></div>
    </div>

    <!-- Main Container -->
    {# <div class="container-fluid py-5"> #}
        <div class="row justify-content-center">
            <div class="col-12 col-xl-11 col-xxl-9">

                <!-- Hero Header Section -->
                <div class="hero-section mb-5">
                    <div class="hero-content-row">
                        {# <div class="hero-icon-wrapper">
                            <div class="hero-icon">
                                <i class="fas fa-images"></i>
                            </div>
                            <div class="hero-glow"></div>
                        </div> #}
                        
                        <div class="hero-text-content">
                            <h1 class="hero-title">Advanced OEM Images Extractor</h1>
                            <p class="hero-subtitle">Professional Google Images Search for Automotive Parts & Components</p>
                        </div>
                    </div>
                    <div class="hero-features">
                        <span class="feature-badge">
                            <i class="fas fa-bolt"></i> Lightning Fast
                        </span>
                        <span class="feature-badge">
                            <i class="fas fa-magic"></i> AI-Powered
                        </span>
                        <span class="feature-badge">
                            <i class="fas fa-shield-alt"></i> High Quality
                        </span>
                    </div>
                </div>

                <!-- Main Glass Card -->
                <div class="main-glass-card">

                    <!-- Enhanced Header -->
                    <div class="glass-header">
                        <div class="header-content">
                            <div class="header-left">
                                <div class="header-icon">
                                    <i class="fas fa-search-plus"></i>
                                </div>
                                <div class="header-text">
                                    <h3 class="header-title">Search Parameters</h3>
                                    <p class="header-subtitle">Configure your OEM part search for optimal results</p>
                                </div>
                            </div>
                            <div class="header-right">
                                <div class="status-indicator">
                                    <div class="status-dot"></div>
                                    <span class="status-text">Ready</span>
                                </div>
                            </div>
                        </div>
                        <div class="header-decoration"></div>
                    </div>

                    <!-- Enhanced Form Body -->
                    <div class="glass-body">

                        <!-- Advanced Search Form -->
                        <form id="searchForm" method="post" class="advanced-form">

                            <!-- Primary Input Row -->
                            <div class="form-row-primary">
                                <div class="input-group-advanced">
                                    <div class="input-wrapper-advanced">
                                        <label for="part_number" class="input-label-advanced">
                                            <span class="label-icon">
                                                <i class="fas fa-hashtag"></i>
                                            </span>
                                            <span class="label-text">OEM Part Number</span>
                                            <span class="label-required">*</span>
                                        </label>
                                        <div class="input-field-wrapper">
                                            <input type="text"
                                                   class="input-field-modern"
                                                   id="part_number"
                                                   name="part_number"
                                                   value="{{ part_number }}"
                                                   placeholder="e.g., BH-7101-01C, WR55X10942, 12345-ABC"
                                                   required>
                                            <div class="input-field-icon">
                                                <i class="fas fa-cog"></i>
                                            </div>
                                            <div class="input-field-border"></div>
                                        </div>
                                    </div>
                                </div>

                                <div class="input-group-advanced">
                                    <div class="input-wrapper-advanced">
                                        <label for="part_title" class="input-label-advanced">
                                            <span class="label-icon">
                                                <i class="fas fa-tag"></i>
                                            </span>
                                            <span class="label-text">Part Title</span>
                                            <span class="label-optional">(Optional)</span>
                                        </label>
                                        <div class="input-field-wrapper">
                                            <input type="text"
                                                   class="input-field-modern"
                                                   id="part_title"
                                                   name="part_title"
                                                   value="{{ part_title|default('') }}"
                                                   placeholder="e.g., Lift Arm Assembly, Control Board">
                                            <div class="input-field-icon">
                                                <i class="fas fa-heading"></i>
                                            </div>
                                            <div class="input-field-border"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Secondary Input Row -->
                            <div class="form-row-secondary">
                                <div class="input-group-full">
                                    <div class="input-wrapper-advanced">
                                        <label for="part_description" class="input-label-advanced">
                                            <span class="label-icon">
                                                <i class="fas fa-align-left"></i>
                                            </span>
                                            <span class="label-text">Part Description</span>
                                            <span class="label-optional">(Optional)</span>
                                        </label>
                                        <div class="input-field-wrapper">
                                            <textarea class="input-field-modern textarea-modern"
                                                      id="part_description"
                                                      name="part_description"
                                                      rows="4"
                                                      placeholder="Provide detailed description for better search accuracy...">{{ part_description|default('') }}</textarea>
                                            <div class="input-field-icon">
                                                <i class="fas fa-file-alt"></i>
                                            </div>
                                            <div class="input-field-border"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Action Buttons Row -->
                            <div class="form-row-actions">
                                <div class="button-group-advanced">
                                    <button type="submit" class="btn-advanced btn-primary-advanced" id="extractBtn">
                                        <div class="btn-content-advanced">
                                            <div class="btn-icon">
                                                <i class="fas fa-search"></i>
                                            </div>
                                            <div class="btn-text">
                                                <span class="btn-main-text">Extract Images</span>
                                                <span class="btn-sub-text">Search & Download</span>
                                            </div>
                                            <div class="btn-arrow">
                                                <i class="fas fa-arrow-right"></i>
                                            </div>
                                        </div>
                                        <div class="btn-shine"></div>
                                    </button>

                                    <button type="button" class="btn-advanced btn-secondary-advanced" onclick="clearForm()">
                                        <div class="btn-content-advanced">
                                            <div class="btn-icon">
                                                <i class="fas fa-eraser"></i>
                                            </div>
                                            <div class="btn-text">
                                                <span class="btn-main-text">Clear Form</span>
                                                <span class="btn-sub-text">Reset All</span>
                                            </div>
                                        </div>
                                    </button>
                                </div>

                                <!-- Quick Examples -->
                                <div class="quick-examples">
                                    <div class="examples-label">
                                        <i class="fas fa-lightbulb"></i>
                                        <span>Quick Examples:</span>
                                    </div>
                                    <div class="examples-buttons">
                                        <button type="button" class="example-btn-modern" data-part="BH-7101-01C" data-title="Lift Arm Assembly">
                                            <span class="example-code">BH-7101-01C</span>
                                            <span class="example-desc">Lift Arm</span>
                                        </button>
                                        <button type="button" class="example-btn-modern" data-part="WR55X10942" data-title="Temperature Sensor">
                                            <span class="example-code">WR55X10942</span>
                                            <span class="example-desc">Sensor</span>
                                        </button>
                                        <button type="button" class="example-btn-modern" data-part="AP3993967" data-title="Control Board">
                                            <span class="example-code">AP3993967</span>
                                            <span class="example-desc">Board</span>
                                        </button>
                                    </div>
                                </div>
                            </div>

                        </form>

                {# Loading Spinner #}
                <div id="loadingSpinner" class="d-none text-center py-5">
                    <div class="mt-3">
                        <small class="text-white-50">
                            Processing: <span id="processingStep">Initializing search...</span>
                        </small>
                    </div>
                </div>

                {# Error Alert #}
                {% if error %}
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Error:</strong> {{ error }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endif %}

                {# Results Section #}
                <div id="resultsSection" class="{% if images is empty %}d-none{% endif %}">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0">
                            <i class="fas fa-list me-2"></i>
                            Extracted Images: 
                            <span class="badge bg-success" id="imageCount">{{ total_images }}</span>
                        </h5>
                        <div>
                            <a href="{{ path('download_image_urls', {part_number: part_number}) }}" 
                                class="btn btn-outline-primary btn-sm me-2" 
                                id="downloadBtn">
                                <i class="fas fa-download me-1"></i>
                                Download URLs
                            </a>
                            <button class="btn btn-outline-secondary btn-sm" onclick="clearResults()">
                                <i class="fas fa-trash me-1"></i>
                                Clear
                            </button>
                        </div>
                    </div>

                    {# Images Grid with Details View #}
                    <div class="row">
                        <div class="col-lg-8">
                            <div id="imagesGrid" class="row g-3">
                                {% for image in images %}
                                        <div class="col-xl-4 col-lg-6 col-md-6 col-sm-12">
                                            <div class="card h-100 image-card" onclick="showImageDetails({{ loop.index0 }}, '{{ image.title|escape('js') }}', '{{ image.description|escape('js') }}', {{ image.dimensions.width ?? 0 }}, {{ image.dimensions.height ?? 0 }}, '{{ image.source|escape('js') }}', '{{ image.method|escape('js') }}', '{{ image.url|escape('js') }}')">
                                                <div class="card-img-top-container" style="height: 180px; overflow: hidden; background: rgba(255, 255, 255, 0.1);">
                                                    <img src="{{ image.url }}"
                                                        class="card-img-top"
                                                        alt="Part {{ part_number }}"
                                                        loading="lazy"
                                                        style="height: 100%; width: 100%; object-fit: contain;"
                                                        onerror="this.src='data:image/svg+xml;base64,'">
                                                    {% if image.dimensions %}
                                                    <div class="image-overlay">
                                                        <span class="badge bg-primary">{{ image.dimensions.width }}×{{ image.dimensions.height }}</span>
                                                    </div>
                                                    {% endif %}
                                                </div>
                                                <div class="card-body p-2">
                                                    <h6 class="card-title text-truncate mb-1" style="font-size: 0.9rem;">
                                                        <i class="fas fa-image me-1 text-info"></i>{{ image.title|length > 30 ? image.title[:30] ~ '...' : image.title }}
                                                    </h6>
                                                    <p class="card-text small text-muted mb-2" style="font-size: 0.75rem;">
                                                        <strong>Source:</strong> <span class="badge bg-light text-dark">{{ image.source }}</span>
                                                    </p>
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <small class="text-white-50">{{ image.method }}</small>
                                                        <a href="{{ image.url }}" target="_blank" class="btn btn-outline-primary btn-sm px-2 py-1" onclick="event.stopPropagation()">
                                                            <i class="fas fa-external-link-alt"></i>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    {% else %}
                                        <div class="col-12">
                                            <div class="text-center py-5">
                                                <i class="fas fa-images fa-3x text-white-50 mb-3"></i>
                                                <h5 class="text-white">No images extracted yet</h5>
                                                <p class="text-white-50">Enter an OEM part number and click "Extract Images" to get started.</p>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                        </div>

                        {# Image Details Sidebar #}
                        <div class="col-lg-4">
                            <div id="imageDetailsPanel" class="card h-100" style="background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.2); display: none;">
                                <div class="card-header" style="border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                                    <h6 class="mb-0 text-white">
                                        <i class="fas fa-info-circle me-2 text-info"></i>Image Details
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <div id="imageDetailsContent">
                                        <div class="text-center text-white-50 py-4">
                                            <i class="fas fa-image fa-2x mb-3"></i>
                                            <p>Click on an image to view details</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {# </div> #}
</div>

{% endblock %}

{% block head_styles %}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
/* ===========================================
   ADVANCED OEM IMAGES EXTRACTOR DESIGN
   =========================================== */

:root {
    /* Monochrome Professional Color Palette */
    --primary-black: #000000;
    --primary-white: #ffffff;
    --primary-gray-50: #f9fafb;
    --primary-gray-100: #f3f4f6;
    --primary-gray-200: #e5e7eb;
    --primary-gray-300: #d1d5db;
    --primary-gray-400: #9ca3af;
    --primary-gray-500: #6b7280;
    --primary-gray-600: #4b5563;
    --primary-gray-700: #374151;
    --primary-gray-800: #1f2937;
    --primary-gray-900: #111827;

    /* Accent Colors */
    --accent-gold: #d4af37;
    --accent-silver: #c0c0c0;
    --accent-blue: #3b82f6;
    --accent-green: #10b981;
    --accent-red: #ef4444;

    /* Background Gradients - Monochrome */
    --bg-gradient-1: linear-gradient(135deg, #000000 0%, #1a1a1a 50%, #000000 100%);
    --bg-gradient-2: linear-gradient(135deg, #111827 0%, #000000 100%);
    --bg-gradient-3: linear-gradient(135deg, #1f2937 0%, #111827 100%);
    --bg-gradient-4: linear-gradient(135deg, #f9fafb 0%, #e5e7eb 100%);
    --bg-gradient-5: linear-gradient(135deg, #ffffff 0%, #f9fafb 100%);

    /* Glass Effects - Dark Theme */
    --glass-bg: rgba(255, 255, 255, 0.03);
    --glass-bg-strong: rgba(255, 255, 255, 0.08);
    --glass-border: rgba(255, 255, 255, 0.1);
    --glass-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    --glass-shadow-hover: 0 12px 40px rgba(0, 0, 0, 0.4);

    /* Typography */
    --font-primary: 'Inter', sans-serif;
    --font-mono: 'JetBrains Mono', monospace;

    /* Spacing & Layout */
    --border-radius: 20px;
    --border-radius-sm: 12px;
    --border-radius-lg: 28px;
    --spacing-xs: 0.5rem;
    --spacing-sm: 0.75rem;
    --spacing-md: 1rem;
    --spacing-lg: 1.5rem;
    --spacing-xl: 2rem;
    --spacing-2xl: 3rem;

    /* Transitions */
    --transition-fast: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-normal: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-slow: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);

    /* Shadows */
    --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    --shadow-glow: 0 0 20px rgba(99, 102, 241, 0.3);
}

/* ===========================================
   GLOBAL STYLES
   =========================================== */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: var(--font-primary);
    background: var(--bg-gradient-1);
    color: #ffffff;
    min-height: 100vh;
    overflow-x: hidden;
    position: relative;
}

/* ===========================================
   ADVANCED BACKGROUND & ANIMATIONS
   =========================================== */

.advanced-bg {
    position: relative;
    min-height: 100vh;
    background:
        radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 80% 80%, rgba(255, 255, 255, 0.02) 0%, transparent 50%),
        radial-gradient(circle at 40% 60%, rgba(255, 255, 255, 0.01) 0%, transparent 50%),
        var(--bg-gradient-1);
    background-attachment: fixed;
}

.floating-shapes {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 1;
}

.shape {
    position: absolute;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    animation: float-shape 20s infinite linear;
}

.shape-1 {
    width: 80px;
    height: 80px;
    top: 10%;
    left: 10%;
    animation-delay: 0s;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
}

.shape-2 {
    width: 120px;
    height: 120px;
    top: 20%;
    right: 15%;
    animation-delay: -5s;
    background: rgba(255, 255, 255, 0.01);
    border: 1px solid rgba(255, 255, 255, 0.03);
}

.shape-3 {
    width: 60px;
    height: 60px;
    bottom: 30%;
    left: 20%;
    animation-delay: -10s;
    background: rgba(255, 255, 255, 0.015);
    border: 1px solid rgba(255, 255, 255, 0.04);
}

.shape-4 {
    width: 100px;
    height: 100px;
    bottom: 20%;
    right: 10%;
    animation-delay: -15s;
    background: rgba(255, 255, 255, 0.008);
    border: 1px solid rgba(255, 255, 255, 0.02);
}

.shape-5 {
    width: 40px;
    height: 40px;
    top: 60%;
    left: 70%;
    animation-delay: -7s;
    background: rgba(255, 255, 255, 0.012);
    border: 1px solid rgba(255, 255, 255, 0.03);
}

.shape-6 {
    width: 90px;
    height: 90px;
    top: 70%;
    right: 30%;
    animation-delay: -12s;
    background: rgba(255, 255, 255, 0.006);
    border: 1px solid rgba(255, 255, 255, 0.02);
}

@keyframes float-shape {
    0%, 100% {
        transform: translateY(0px) rotate(0deg) scale(1);
    }
    25% {
        transform: translateY(-20px) rotate(90deg) scale(1.1);
    }
    50% {
        transform: translateY(-10px) rotate(180deg) scale(0.9);
    }
    75% {
        transform: translateY(-30px) rotate(270deg) scale(1.05);
    }
}

/* ===========================================
   HERO SECTION
   =========================================== */

.hero-section {
    position: relative;
    z-index: 2;
    margin-bottom: var(--spacing-2xl);
}

.hero-content-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-xl);
    margin-bottom: var(--spacing-lg);
    flex-wrap: wrap;
}

.hero-text-content {
    text-align: left;
}

.hero-icon-wrapper {
    flex-shrink: 0;
}

.hero-icon-wrapper {
    position: relative;
    display: inline-block;
    margin-bottom: var(--spacing-lg);
}

.hero-icon {
    width: 120px;
    height: 120px;
    background: var(--glass-bg-strong);
    backdrop-filter: blur(20px);
    border: 2px solid var(--glass-border);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    color: #ffffff;
    position: relative;
    z-index: 2;
    box-shadow: var(--shadow-xl);
    transition: var(--transition-normal);
}

.hero-icon:hover {
    transform: scale(1.05) rotate(5deg);
    box-shadow: var(--shadow-glow);
}

.hero-glow {
    position: absolute;
    top: -10px;
    left: -10px;
    right: -10px;
    bottom: -10px;
    background: var(--bg-gradient-3);
    border-radius: 50%;
    opacity: 0.3;
    animation: pulse-glow 3s infinite;
    z-index: 1;
}

@keyframes pulse-glow {
    0%, 100% { opacity: 0.3; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(1.1); }
}

.hero-title {
    font-size: 3.5rem;
    font-weight: 800;
    color: var(--primary-white);
    margin-bottom: var(--spacing-md);
    text-shadow:
        0 2px 4px rgba(0, 0, 0, 0.5),
        0 4px 8px rgba(0, 0, 0, 0.3),
        0 8px 16px rgba(0, 0, 0, 0.2);
    letter-spacing: -0.02em;
    position: relative;
    margin: 0;
}

.hero-title::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 0;
    width: 100px;
    height: 3px;
    background: linear-gradient(90deg, var(--accent-gold), var(--accent-silver));
    border-radius: 2px;
}

.hero-subtitle {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.9);
    font-weight: 400;
    margin-bottom: var(--spacing-xl);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
}

.hero-features {
    display: flex;
    justify-content: center;
    gap: var(--spacing-md);
    flex-wrap: wrap;
}

.feature-badge {
    background: var(--glass-bg);
    backdrop-filter: blur(10px);
    border: 1px solid var(--glass-border);
    border-radius: var(--border-radius-lg);
    padding: var(--spacing-sm) var(--spacing-lg);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--primary-white);
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    box-shadow: var(--shadow-md);
    transition: var(--transition-fast);
    position: relative;
    overflow: hidden;
}

.feature-badge::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.1), transparent);
    transition: left 0.6s;
}

.feature-badge:hover::before {
    left: 100%;
}

.feature-badge:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
    border-color: var(--accent-gold);
}

.feature-badge i {
    color: var(--accent-gold);
}

/* ===========================================
   MAIN GLASS CARD
   =========================================== */

.main-glass-card {
    background: var(--glass-bg);
    backdrop-filter: blur(25px);
    border: 1px solid var(--glass-border);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--glass-shadow);
    position: relative;
    z-index: 2;
    overflow: hidden;
    transition: var(--transition-normal);
}

.main-glass-card:hover {
    box-shadow: var(--glass-shadow-hover);
    transform: translateY(-2px);
}

.main-glass-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--bg-gradient-3);
    z-index: 3;
}

/* ===========================================
   GLASS HEADER
   =========================================== */

.glass-header {
    background: var(--glass-bg-strong);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--glass-border);
    padding: var(--spacing-2xl) var(--spacing-2xl);
    position: relative;
    overflow: hidden;
}

.glass-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.02) 0%, transparent 50%, rgba(255, 255, 255, 0.01) 100%);
    pointer-events: none;
}

.header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
    z-index: 2;
}

.header-left {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
}

.header-icon {
    width: 60px;
    height: 60px;
    background: var(--bg-gradient-3);
    border-radius: var(--border-radius);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    color: white;
    box-shadow: var(--shadow-lg);
}

.header-text h3 {
    font-size: 1.75rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: var(--spacing-xs);
}

.header-text p {
    color: rgba(255, 255, 255, 0.8);
    font-size: 1rem;
    margin: 0;
}

.header-right {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
}

.status-indicator {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    background: var(--glass-bg);
    backdrop-filter: blur(10px);
    border: 1px solid var(--glass-border);
    border-radius: var(--border-radius-lg);
    padding: var(--spacing-xs) var(--spacing-md);
}

.status-dot {
    width: 8px;
    height: 8px;
    background: var(--success-color);
    border-radius: 50%;
    animation: pulse-dot 2s infinite;
}

@keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
}

.status-text {
    font-size: 0.875rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
}

.header-decoration {
    position: absolute;
    top: 0;
    right: 0;
    width: 200px;
    height: 100%;
    background: linear-gradient(135deg, transparent 0%, rgba(255, 255, 255, 0.05) 50%, transparent 100%);
    transform: skewX(-15deg);
    z-index: 1;
}

/* ===========================================
   GLASS BODY & FORM
   =========================================== */

.glass-body {
    padding: var(--spacing-2xl);
}

.advanced-form {
    width: 100%;
}

/* Form Rows */
.form-row-primary {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-xl);
    margin-bottom: var(--spacing-2xl);
}

.form-row-secondary {
    margin-bottom: var(--spacing-2xl);
}

.form-row-actions {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
}

/* Input Groups */
.input-group-advanced {
    width: 100%;
}

.input-group-full {
    width: 100%;
}

.input-wrapper-advanced {
    width: 100%;
}

/* Input Labels */
.input-label-advanced {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: 1rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: var(--spacing-md);
}

.label-icon {
    width: 24px;
    height: 24px;
    background: linear-gradient(135deg, var(--accent-gold), var(--accent-silver));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    color: var(--primary-black);
    box-shadow: 0 2px 8px rgba(212, 175, 55, 0.3);
}

.label-text {
    font-size: 1rem;
    font-weight: 600;
}

.label-required {
    color: var(--error-color);
    font-size: 1.1rem;
    font-weight: 700;
}

.label-optional {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.875rem;
    font-weight: 400;
}

/* Input Fields */
.input-field-wrapper {
    position: relative;
}

.input-field-modern {
    width: 100%;
    background: var(--glass-bg);
    backdrop-filter: blur(15px);
    border: 2px solid var(--glass-border);
    border-radius: var(--border-radius);
    padding: var(--spacing-lg) var(--spacing-lg) var(--spacing-lg) 3rem;
    font-size: 1rem;
    font-family: var(--font-primary);
    color: var(--primary-white);
    transition: var(--transition-fast);
    outline: none;
    position: relative;
}

.input-field-modern::placeholder {
    color: var(--primary-gray-400);
}

.input-field-modern:focus {
    background: var(--glass-bg-strong);
    border-color: var(--accent-gold);
    box-shadow:
        0 0 0 3px rgba(212, 175, 55, 0.1),
        0 4px 12px rgba(0, 0, 0, 0.15);
    transform: translateY(-1px);
}

.input-field-modern.is-valid {
    border-color: var(--accent-green);
    box-shadow:
        0 0 0 3px rgba(16, 185, 129, 0.1),
        0 4px 12px rgba(0, 0, 0, 0.15);
}

.input-field-modern.is-invalid {
    border-color: var(--accent-red);
    box-shadow:
        0 0 0 3px rgba(239, 68, 68, 0.1),
        0 4px 12px rgba(0, 0, 0, 0.15);
}

.textarea-modern {
    resize: vertical;
    min-height: 120px;
    padding-top: var(--spacing-lg);
}

.input-field-icon {
    position: absolute;
    top: 50%;
    left: var(--spacing-md);
    transform: translateY(-50%);
    color: rgba(255, 255, 255, 0.7);
    font-size: 1.1rem;
    pointer-events: none;
}

.input-field-border {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent-gold), var(--accent-silver));
    transform: scaleX(0);
    transition: var(--transition-fast);
}

.input-field-modern:focus + .input-field-border {
    transform: scaleX(1);
}

/* ===========================================
   ADVANCED BUTTONS
   =========================================== */

.button-group-advanced {
    display: flex;
    gap: var(--spacing-lg);
    justify-content: center;
    flex-wrap: wrap;
}

.btn-advanced {
    border: none;
    border-radius: var(--border-radius-lg);
    font-family: var(--font-primary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: var(--transition-normal);
    outline: none;
    min-height: 60px;
    box-shadow: var(--shadow-lg);
}

.btn-content-advanced {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-md);
    position: relative;
    z-index: 2;
}

.btn-icon {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
}

.btn-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
}

.btn-main-text {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1;
}

.btn-sub-text {
    font-size: 0.75rem;
    font-weight: 400;
    opacity: 0.8;
}

.btn-arrow {
    font-size: 0.875rem;
    transition: var(--transition-fast);
}

.btn-shine {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transition: left 0.6s;
}

.btn-advanced:hover .btn-shine {
    left: 100%;
}

.btn-advanced:hover .btn-arrow {
    transform: translateX(4px);
}

/* Primary Button */
.btn-primary-advanced {
    background: linear-gradient(135deg, var(--accent-gold) 0%, var(--accent-silver) 100%);
    color: var(--primary-black);
    min-width: 200px;
    box-shadow: 0 8px 25px rgba(212, 175, 55, 0.3);
    font-weight: 700;
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.2);
}

.btn-primary-advanced:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 35px rgba(212, 175, 55, 0.4);
    background: linear-gradient(135deg, var(--accent-silver) 0%, var(--accent-gold) 100%);
}

/* Secondary Button */
.btn-secondary-advanced {
    background: var(--glass-bg);
    backdrop-filter: blur(15px);
    border: 2px solid var(--glass-border);
    color: var(--primary-white);
    min-width: 160px;
}

.btn-secondary-advanced:hover {
    background: var(--glass-bg-strong);
    border-color: var(--accent-silver);
    transform: translateY(-2px);
    box-shadow: var(--shadow-xl);
    color: var(--primary-white);
}

/* ===========================================
   QUICK EXAMPLES
   =========================================== */

.quick-examples {
    background: var(--glass-bg);
    backdrop-filter: blur(10px);
    border: 1px solid var(--glass-border);
    border-radius: var(--border-radius);
    padding: var(--spacing-lg);
    margin-top: var(--spacing-lg);
}

.examples-label {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: 0.875rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: var(--spacing-md);
}

.examples-label i {
    color: var(--accent-color);
}

.examples-buttons {
    display: flex;
    gap: var(--spacing-md);
    flex-wrap: wrap;
}

.example-btn-modern {
    background: var(--glass-bg-strong);
    backdrop-filter: blur(15px);
    border: 1px solid var(--glass-border);
    border-radius: var(--border-radius);
    padding: var(--spacing-md);
    cursor: pointer;
    transition: var(--transition-fast);
    outline: none;
    min-width: 120px;
    text-align: center;
    position: relative;
    overflow: hidden;
}

.example-btn-modern::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.1), transparent);
    transition: left 0.6s;
}

.example-btn-modern:hover::before {
    left: 100%;
}

.example-btn-modern:hover {
    background: var(--glass-bg);
    border-color: var(--accent-gold);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
}

.example-code {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--primary-color);
    margin-bottom: 2px;
}

.example-desc {
    display: block;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.7);
    font-weight: 400;
}

/* ===========================================
   ADVANCED TOAST NOTIFICATIONS
   =========================================== */

.advanced-toast {
    position: fixed;
    top: 20px;
    right: 20px;
    min-width: 350px;
    max-width: 450px;
    background: var(--glass-bg-strong);
    backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-xl);
    z-index: 10000;
    transform: translateX(100%);
    opacity: 0;
    transition: var(--transition-normal);
    overflow: hidden;
}

.advanced-toast.show {
    transform: translateX(0);
    opacity: 1;
}

.toast-content {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-md);
    padding: var(--spacing-lg);
}

.toast-icon {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
}

.toast-success .toast-icon {
    background: var(--success-color);
    color: white;
}

.toast-error .toast-icon {
    background: var(--error-color);
    color: white;
}

.toast-warning .toast-icon {
    background: var(--warning-color);
    color: white;
}

.toast-text {
    flex: 1;
}

.toast-title {
    font-weight: 700;
    font-size: 0.875rem;
    margin-bottom: 2px;
    color: #ffffff;
}

.toast-message {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.4;
}

.toast-close {
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    padding: 4px;
    border-radius: 50%;
    transition: var(--transition-fast);
    flex-shrink: 0;
}

.toast-close:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
}

.toast-progress {
    height: 3px;
    background: rgba(255, 255, 255, 0.1);
    position: relative;
    overflow: hidden;
}

.toast-progress-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--accent-gold), var(--accent-silver));
    width: 100%;
    animation: toast-progress 5s linear forwards;
}

@keyframes toast-progress {
    0% { width: 100%; }
    100% { width: 0%; }
}

/* ===========================================
   RESPONSIVE DESIGN
   =========================================== */

@media (max-width: 768px) {
    .hero-content-row {
        flex-direction: column;
        text-align: center;
        gap: var(--spacing-lg);
    }

    .hero-text-content {
        text-align: center;
    }

    .hero-title {
        font-size: 2.5rem;
    }

    .hero-subtitle {
        font-size: 1.1rem;
    }

    .form-row-primary {
        grid-template-columns: 1fr;
        gap: var(--spacing-lg);
    }

    .button-group-advanced {
        flex-direction: column;
        align-items: stretch;
    }

    .btn-advanced {
        min-width: auto;
    }

    .examples-buttons {
        flex-direction: column;
    }

    .example-btn-modern {
        min-width: auto;
    }

    .glass-header,
    .glass-body {
        padding: var(--spacing-xl);
    }

    .header-content {
        flex-direction: column;
        gap: var(--spacing-lg);
        text-align: center;
    }
}

@media (max-width: 480px) {
    .hero-title {
        font-size: 2rem;
    }

    .hero-features {
        flex-direction: column;
        align-items: center;
    }

    .glass-header,
    .glass-body {
        padding: var(--spacing-lg);
    }
}

* {
    box-sizing: border-box;
}

body {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    font-family: 'Inter', sans-serif;
    min-height: 100vh;
    margin: 0;
    color: #ffffff;
    overflow-x: hidden;
}

/* Animated Background */
body::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background:
        radial-gradient(circle at 20% 80%, rgba(120, 119, 198, 0.3) 0%, transparent 50%),
        radial-gradient(circle at 80% 20%, rgba(255, 119, 198, 0.3) 0%, transparent 50%),
        radial-gradient(circle at 40% 40%, rgba(120, 219, 226, 0.3) 0%, transparent 50%);
    animation: float 20s ease-in-out infinite;
    z-index: -1;
}

@keyframes float {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    33% { transform: translateY(-20px) rotate(1deg); }
    66% { transform: translateY(10px) rotate(-1deg); }
}

/* Glassmorphism Container */
.container-fluid {
    max-width: 1400px;
    position: relative;
}

/* Main Card with Glass Effect */
.card {
    background: var(--glass-bg);
    backdrop-filter: var(--blur);
    -webkit-backdrop-filter: var(--blur);
    border: 1px solid var(--glass-border);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-light);
    transition: var(--transition);
    overflow: hidden;
}

.card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-dark);
}

/* Header with Gradient */
.card-header {
    background: var(--primary-gradient);
    border: none;
    padding: 2rem;
    position: relative;
    overflow: hidden;
}

.card-header::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.1), transparent);
    animation: shimmer 3s infinite;
}

@keyframes shimmer {
    0% { transform: translateX(-100%) translateY(-100%) rotate(45deg); }
    100% { transform: translateX(100%) translateY(100%) rotate(45deg); }
}

.card-header h4 {
    margin: 0;
    font-weight: 700;
    font-size: 1.8rem;
    position: relative;
    z-index: 2;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
}

.card-header .badge {
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    position: relative;
    z-index: 2;
}

/* Card Body */
.card-body {
    padding: 2.5rem;
    background: rgba(255, 255, 255, 0.05);
}

/* Form Styling */
.form-label {
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 0.75rem;
    font-size: 1.1rem;
}

.form-control {
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    font-size: 1.1rem;
    color: #ffffff;
    transition: var(--transition);
    backdrop-filter: blur(10px);
}

.form-control::placeholder {
    color: rgba(255, 255, 255, 0.6);
}

.form-control:focus {
    background: rgba(255, 255, 255, 0.15);
    border-color: #ffffff;
    box-shadow: 0 0 0 0.2rem rgba(255, 255, 255, 0.25);
    color: #ffffff;
}

.form-control.is-valid {
    border-color: #28a745;
    box-shadow: 0 0 0 0.2rem rgba(40, 167, 69, 0.25);
}

.form-control.is-invalid {
    border-color: #dc3545;
    box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25);
}

/* Buttons */
.btn {
    border-radius: 12px;
    font-weight: 600;
    padding: 0.875rem 2rem;
    font-size: 1.1rem;
    transition: var(--transition);
    border: none;
    position: relative;
    overflow: hidden;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
    transition: left 0.6s;
}

.btn:hover::before {
    left: 100%;
}

.btn-success {
    background: var(--success-gradient);
    color: white;
    box-shadow: 0 4px 15px rgba(79, 172, 254, 0.4);
}

.btn-success:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(79, 172, 254, 0.6);
}

.btn-outline-primary {
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 255, 255, 0.3);
    color: white;
    backdrop-filter: blur(10px);
}

.btn-outline-primary:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: white;
    color: white;
    transform: translateY(-2px);
}

.btn-outline-secondary {
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 255, 255, 0.2);
    color: white;
    backdrop-filter: blur(10px);
}

.btn-outline-secondary:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-2px);
}

/* Loading Spinner */
.spinner-border {
    width: 3rem;
    height: 3rem;
    border-width: 0.3em;
    border-color: rgba(255, 255, 255, 0.3);
    border-right-color: white;
}

/* Image Cards */
.image-card {
    background: var(--glass-bg);
    backdrop-filter: var(--blur);
    border: 1px solid var(--glass-border);
    border-radius: var(--border-radius);
    overflow: hidden;
    transition: var(--transition);
    box-shadow: var(--shadow-light);
    margin-bottom: 1rem;
}

.image-card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: var(--shadow-dark);
    border-color: rgba(255, 255, 255, 0.3);
}

.card-img-top-container {
    height: 220px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
}

.card-img-top-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(45deg, transparent 30%, rgba(255, 255, 255, 0.1) 50%, transparent 70%);
    animation: shine 3s infinite;
}

@keyframes shine {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
}

.card-img-top-container img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 12px 12px 0 0;
    transition: var(--transition);
    position: relative;
    z-index: 2;
}

.card-img-top-container:hover img {
    transform: scale(1.1) rotate(1deg);
}

.card-body {
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.05);
}

.card-title {
    font-size: 1rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.card-title i {
    color: #4facfe;
}

.url-text {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.8);
    word-break: break-all;
    background: rgba(0, 0, 0, 0.2);
    padding: 0.5rem;
    border-radius: 8px;
    margin: 0.75rem 0;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

/* Badges */
.badge {
    background: var(--accent-gradient);
    color: white;
    font-weight: 600;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.8rem;
    box-shadow: 0 2px 10px rgba(67, 233, 123, 0.3);
}

/* Alerts */
.alert {
    background: rgba(220, 53, 69, 0.2);
    border: 1px solid rgba(220, 53, 69, 0.3);
    border-radius: var(--border-radius);
    color: #ffffff;
    backdrop-filter: blur(10px);
}

.alert-danger {
    background: rgba(220, 53, 69, 0.2);
    border-color: rgba(220, 53, 69, 0.3);
}

/* Example Buttons */
.example-btn {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    color: white;
    font-weight: 500;
    transition: var(--transition);
    backdrop-filter: blur(10px);
    margin-bottom: 0.75rem;
}

.example-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
}

/* Results Section */
#resultsSection {
    margin-top: 2.5rem;
    padding: 2rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: var(--border-radius);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
}

#imageCount {
    font-size: 1.5rem;
    font-weight: 700;
    color: #4facfe;
    text-shadow: 0 2px 4px rgba(79, 172, 254, 0.3);
}

/* No Results */
.text-center {
    color: white;
}

.text-center i {
    font-size: 5rem;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 1.5rem;
    animation: pulse 2s infinite;
}

.text-center h5 {
    color: #ffffff;
    font-weight: 600;
    margin-bottom: 1rem;
}

.text-center p {
    color: rgba(255, 255, 255, 0.8);
    font-size: 1.2rem;
}

/* Animations */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.fade-in {
    animation: fadeInUp 0.6s ease-out;
}

/* Responsive Design */
@media (max-width: 768px) {
    .card-body {
        padding: 1.5rem;
    }

    .card-header {
        padding: 1.5rem;
    }

    .card-header h4 {
        font-size: 1.5rem;
    }

    .btn {
        padding: 0.75rem 1.5rem;
        font-size: 1rem;
    }

    .form-control {
        font-size: 1rem;
        padding: 0.875rem 1rem;
    }

    .col-xl-3, .col-lg-4 {
        margin-bottom: 1.5rem;
    }

    .card-img-top-container {
        height: 180px;
    }
}

/* Custom Scrollbar */
::-webkit-scrollbar {
    width: 8px;
}

::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
}

::-webkit-scrollbar-thumb {
    background: var(--primary-gradient);
    border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
    background: var(--secondary-gradient);
}

/* Loading State */
.loading {
    animation: pulse 1.5s infinite;
}

/* Image Overlay */
.image-overlay {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(5px);
    border-radius: 8px;
    padding: 4px 8px;
}

/* Details Panel */
#imageDetailsPanel {
    position: sticky;
    top: 20px;
    max-height: calc(100vh - 40px);
    overflow-y: auto;
}

#imageDetailsPanel .card-body {
    padding: 1.5rem;
}

/* Enhanced Image Cards */
.image-card {
    cursor: pointer;
    transition: var(--transition);
}

.image-card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: var(--shadow-dark);
}

.image-card.selected {
    border-color: #4facfe;
    box-shadow: 0 0 0 2px rgba(79, 172, 254, 0.3);
}

/* Toast Notifications */
.toast-notification {
    position: fixed;
    top: 20px;
    right: 20px;
    background: var(--glass-bg);
    backdrop-filter: var(--blur);
    border: 1px solid var(--glass-border);
    border-radius: var(--border-radius);
    padding: 1rem 1.5rem;
    box-shadow: var(--shadow-dark);
    z-index: 9999;
    animation: slideInRight 0.3s ease-out;
}

@keyframes slideInRight {
    from {
        transform: translateX(100%);
        opacity: 0;
    }
    to {
        transform: translateX(0);
        opacity: 1;
    }
}
</style>
{% endblock %}

{% block scripts %}
{# {{ parent() }} #}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchForm = document.getElementById('searchForm');
    const loadingSpinner = document.getElementById('loadingSpinner');
    const resultsSection = document.getElementById('resultsSection');
    const imagesGrid = document.getElementById('imagesGrid');
    const noResults = document.getElementById('noResults');
    const imageCount = document.getElementById('imageCount');
    const extractBtn = document.getElementById('extractBtn');
    const downloadBtn = document.getElementById('downloadBtn');
    const partNumberInput = document.getElementById('part_number');
    const partTitleInput = document.getElementById('part_title');
    const partDescriptionInput = document.getElementById('part_description');

    // Add fade-in animation to cards
    function addFadeInAnimation(element) {
        element.classList.add('fade-in');
    }

    // Example buttons with enhanced animation
    document.querySelectorAll('.example-btn-modern').forEach(btn => {
        btn.addEventListener('click', function() {
            const partNumber = this.dataset.part;
            const partTitle = this.dataset.title;

            partNumberInput.value = partNumber;
            partTitleInput.value = partTitle;

            // Add visual feedback
            this.style.transform = 'scale(0.95)';
            this.style.background = 'var(--bg-gradient-3)';

            setTimeout(() => {
                this.style.transform = '';
                this.style.background = '';
                searchForm.dispatchEvent(new Event('submit'));
            }, 200);
        });
    });

    // Clear form function
    window.clearForm = function() {
        partNumberInput.value = '';
        partTitleInput.value = '';
        partDescriptionInput.value = '';

        // Remove validation classes
        [partNumberInput, partTitleInput, partDescriptionInput].forEach(input => {
            input.classList.remove('is-valid', 'is-invalid');
        });

        // Reset button states
        extractBtn.innerHTML = '<div class="btn-content-advanced"><div class="btn-icon"><i class="fas fa-search"></i></div><div class="btn-text"><span class="btn-main-text">Extract Images</span><span class="btn-sub-text">Search & Download</span></div><div class="btn-arrow"><i class="fas fa-arrow-right"></i></div></div><div class="btn-shine"></div>';

        // Show success message
        showToast('Form cleared successfully!', 'success');
    };

    // Input validation and enhancement
    partNumberInput.addEventListener('input', function() {
        const value = this.value.trim();
        if (value.length > 0) {
            this.classList.add('is-valid');
            this.classList.remove('is-invalid');
        } else {
            this.classList.remove('is-valid', 'is-invalid');
        }
    });

    // Form submission with enhanced UX
    searchForm.addEventListener('submit', function(e) {
        e.preventDefault();

        const partNumber = partNumberInput.value.trim();
        if (!partNumber) {
            showError('Please enter an OEM part number');
            partNumberInput.classList.add('is-invalid');
            partNumberInput.focus();
            return;
        }

        partNumberInput.classList.remove('is-invalid');
        partNumberInput.classList.add('is-valid');

        // Enhanced loading state with progress updates
        loadingSpinner.classList.remove('d-none');
        resultsSection.classList.add('d-none');
        extractBtn.disabled = true;
        extractBtn.innerHTML = '<div class="btn-content-advanced"><div class="btn-icon"><i class="fas fa-spinner fa-spin"></i></div><div class="btn-text"><span class="btn-main-text">Extracting...</span><span class="btn-sub-text">Please wait</span></div></div>';

        // Update loading messages
        const loadingSteps = [
            'Initializing search...',
            'Querying Google Images...',
            'Processing image results...',
            'Analyzing dimensions...',
            'Generating metadata...',
            'Finalizing results...'
        ];

        let stepIndex = 0;
        const stepInterval = setInterval(() => {
            if (stepIndex < loadingSteps.length) {
                document.getElementById('processingStep').textContent = loadingSteps[stepIndex];
                stepIndex++;
            }
        }, 3000);

        // Clear previous results
        clearResults();

        // AJAX request with timeout
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 60000); // 60 second timeout for image processing

        fetch('{{ path("extract_images_ajax") }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: new URLSearchParams({
                'part_number': partNumber,
                'part_title': partTitleInput.value.trim(),
                'part_description': partDescriptionInput.value.trim()
            }),
            signal: controller.signal
        })
        .then(response => {
            clearTimeout(timeoutId);
            if (!response.ok) {
                throw new Error(`HTTP ${response.status}: ${response.statusText}`);
            }
            return response.json();
        })
        .then(data => {
            clearInterval(stepInterval);
            loadingSpinner.classList.add('d-none');
            extractBtn.disabled = false;
            extractBtn.innerHTML = '<div class="btn-content-advanced"><div class="btn-icon"><i class="fas fa-search"></i></div><div class="btn-text"><span class="btn-main-text">Extract Images</span><span class="btn-sub-text">Search & Download</span></div><div class="btn-arrow"><i class="fas fa-arrow-right"></i></div></div>';

            if (data.success) {
                updateResults(data.images, data.total, partNumber);
            } else {
                showError(data.error || 'Failed to extract images');
            }
        })
        .catch(error => {
            clearTimeout(timeoutId);
            clearInterval(stepInterval);
            loadingSpinner.classList.add('d-none');
            extractBtn.disabled = false;
            extractBtn.innerHTML = '<div class="btn-content-advanced"><div class="btn-icon"><i class="fas fa-search"></i></div><div class="btn-text"><span class="btn-main-text">Extract Images</span><span class="btn-sub-text">Search & Download</span></div><div class="btn-arrow"><i class="fas fa-arrow-right"></i></div></div>';

            if (error.name === 'AbortError') {
                showError('Request timed out. Please try again.');
            } else {
                showError('Network error: ' + error.message);
            }
        });
    });

    function updateResults(images, total, partNumber) {
        // Animate counter
        animateCounter(imageCount, 0, total, 1000);

        if (total > 0) {
            // Update images grid with staggered animation
            imagesGrid.innerHTML = '';
            images.forEach((image, index) => {
                const col = document.createElement('div');
                col.className = 'col-xl-3 col-lg-4 col-md-6 col-sm-12';
                col.style.animationDelay = `${index * 0.1}s`;

                col.innerHTML = `
                    <div class="card h-100 image-card fade-in">
                        <div class="card-img-top-container">
                            <img src="${image.url}"
                                 class="card-img-top"
                                 alt="Part ${partNumber}"
                                 loading="lazy"
                                 onerror="handleImageError(this)">
                        </div>
                        <div class="card-body">
                            <h6 class="card-title text-truncate" title="${image.url}">
                                <i class="fas fa-image me-1"></i>Image ${index + 1}
                            </h6>
                            <p class="card-text small text-muted mb-1">
                                <strong>Source:</strong> <span class="badge bg-light text-dark">${image.source}</span>
                            </p>
                            <p class="card-text small text-muted mb-2 url-text">
                                ${image.url.length > 50 ? image.url.substring(0, 50) + '...' : image.url}
                            </p>
                            <div class="d-grid gap-1">
                                <a href="${image.url}"
                                   target="_blank"
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-external-link-alt me-1"></i>
                                    Open Original
                                </a>
                                <button class="btn btn-outline-secondary btn-sm"
                                        onclick="copyToClipboard('${image.url}')">
                                    <i class="fas fa-copy me-1"></i>
                                    Copy URL
                                </button>
                            </div>
                        </div>
                    </div>
                `;

                imagesGrid.appendChild(col);
            });

            // Update download link
            downloadBtn.href = `{{ path('download_image_urls') }}?part_number=${encodeURIComponent(partNumber)}`;

            noResults.classList.add('d-none');
            resultsSection.classList.remove('d-none');
            addFadeInAnimation(resultsSection);
        } else {
            imagesGrid.innerHTML = '';
            noResults.classList.remove('d-none');
            resultsSection.classList.remove('d-none');
            addFadeInAnimation(resultsSection);
        }
    }

    function animateCounter(element, start, end, duration) {
        const startTime = performance.now();
        const updateCounter = (currentTime) => {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);
            const current = Math.floor(start + (end - start) * progress);
            element.textContent = current;

            if (progress < 1) {
                requestAnimationFrame(updateCounter);
            }
        };
        requestAnimationFrame(updateCounter);
    }

    function handleImageError(img) {
        img.src = 'data:image/svg+xml;base64,';
        img.alt = 'Image not available';
    }

    function showToast(message, type = 'error') {
        // Create advanced toast notification
        const toast = document.createElement('div');
        toast.className = `advanced-toast toast-${type}`;
        toast.innerHTML = `
            <div class="toast-content">
                <div class="toast-icon">
                    <i class="fas ${type === 'success' ? 'fa-check-circle' : type === 'warning' ? 'fa-exclamation-triangle' : 'fa-times-circle'}"></i>
                </div>
                <div class="toast-text">
                    <div class="toast-title">${type === 'success' ? 'Success' : type === 'warning' ? 'Warning' : 'Error'}</div>
                    <div class="toast-message">${message}</div>
                </div>
                <button class="toast-close" onclick="this.parentElement.parentElement.remove()">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="toast-progress">
                <div class="toast-progress-bar"></div>
            </div>
        `;

        document.body.appendChild(toast);

        // Trigger animation
        setTimeout(() => toast.classList.add('show'), 10);

        // Auto remove after 5 seconds
        setTimeout(() => {
            toast.classList.remove('show');
            setTimeout(() => {
                if (toast.parentNode) {
                    toast.remove();
                }
            }, 300);
        }, 5000);
    }

    function showError(message) {
        showToast(message, 'error');
    }

    window.clearResults = function() {
        imagesGrid.innerHTML = '';
        resultsSection.classList.add('d-none');
        imageCount.textContent = '0';
    };

    window.copyToClipboard = function(text) {
        navigator.clipboard.writeText(text).then(() => {
            // Show temporary success feedback
            const notification = document.createElement('div');
            notification.className = 'alert alert-success position-fixed';
            notification.style.cssText = 'top: 20px; left: 20px; z-index: 9999;';
            notification.innerHTML = '<i class="fas fa-check me-2"></i>URL copied to clipboard!';

            document.body.appendChild(notification);
            setTimeout(() => notification.remove(), 2000);
        }).catch(() => {
            showError('Failed to copy URL');
        });
    };

    window.showImageDetails = function(index, title, description, width, height, source, method, imageUrl) {
        const detailsPanel = document.getElementById('imageDetailsPanel');
        const detailsContent = document.getElementById('imageDetailsContent');

        // Show the panel
        detailsPanel.style.display = 'block';

        // Update content
        detailsContent.innerHTML = `
            <div class="text-center mb-4">
                <img src="${imageUrl}" class="img-fluid rounded" style="max-height: 200px; object-fit: contain;" alt="Selected Image">
            </div>

            <h6 class="text-info mb-3">
                <i class="fas fa-tag me-1"></i>Title
            </h6>
            <p class="text-white mb-4">${title}</p>

            <h6 class="text-info mb-3">
                <i class="fas fa-align-left me-1"></i>Description
            </h6>
            <p class="text-white mb-4">${description}</p>

            <h6 class="text-info mb-3">
                <i class="fas fa-expand me-1"></i>Dimensions
            </h6>
            <p class="mb-4">
                <span class="badge bg-primary me-2">${width}×${height}</span>
                <small class="text-white-50">Aspect Ratio: ${(width/height).toFixed(2)}</small>
            </p>

            <h6 class="text-info mb-3">
                <i class="fas fa-server me-1"></i>Source & Method
            </h6>
            <p class="mb-4">
                <span class="badge bg-success me-2">${source}</span>
                <span class="badge bg-secondary">${method}</span>
            </p>

            <h6 class="text-info mb-3">
                <i class="fas fa-file-image me-1"></i>Image Info
            </h6>
            <div class="small text-white-50 mb-4">
                <p><strong>File Size:</strong> ~${Math.round((width * height * 3) / 1024)} KB (estimated)</p>
                <p><strong>Format:</strong> JPEG/PNG/WebP</p>
                <p><strong>Quality:</strong> High Resolution</p>
            </div>

            <div class="d-grid gap-2">
                <a href="${imageUrl}" target="_blank" class="btn btn-primary">
                    <i class="fas fa-external-link-alt me-1"></i>Open Full Size
                </a>
                <button class="btn btn-outline-light" onclick="copyToClipboard('${imageUrl}')">
                    <i class="fas fa-copy me-1"></i>Copy URL
                </button>
            </div>
        `;

        // Scroll to top of details panel
        detailsPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    // Add keyboard shortcuts
    document.addEventListener('keydown', function(e) {
        // Ctrl/Cmd + Enter to submit form
        if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
            e.preventDefault();
            searchForm.dispatchEvent(new Event('submit'));
        }

        // Escape to clear results
        if (e.key === 'Escape') {
            clearResults();
        }
    });

    // Add loading animation to body when extracting
    let loadingClassAdded = false;
    const observer = new MutationObserver(() => {
        const isLoading = !loadingSpinner.classList.contains('d-none');
        if (isLoading && !loadingClassAdded) {
            document.body.classList.add('loading');
            loadingClassAdded = true;
        } else if (!isLoading && loadingClassAdded) {
            document.body.classList.remove('loading');
            loadingClassAdded = false;
        }
    });

    observer.observe(loadingSpinner, { attributes: true, attributeFilter: ['class'] });
});
</script>
{% endblock %}