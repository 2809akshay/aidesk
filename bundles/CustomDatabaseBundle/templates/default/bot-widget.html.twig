{# src/CustomDatabase/Resources/views/default/bot-widget.html.twig #}
<script src="{{ asset('bundles/customdatabase/static/bot/script.js') }}"></script>
<link rel="stylesheet" href="{{ asset('bundles/customdatabase/static/bot/style.css') }}">
<div id="ai-orb-container">
     
    <div id="ai-orb">
        <div class="pulse"></div>
        <div class="wave"></div>
        <div class="neural-node node-1"></div>
        <div class="neural-node node-2"></div>
        <div class="neural-node node-3"></div>
        <div class="neural-node node-4"></div>
    </div>
    <div class="pulse">
       <div style="position: relative; width: 1900px; height: 1900px;">
        <iframe 
            src="https://my.spline.design/genkubgreetingrobot-613xRNoVbLK7UPkYSzJSF9hA/" 
            frameborder="0"
            width="40%"
            height="40%"
            style="border-radius: 50%; overflow: hidden;"
        ></iframe>
        </div>
    </div>

    <div id="ai-structure">
        <div class="structure-header">
            <i class="fas fa-brain"></i>
            <h3>Neural Network Active</h3>
