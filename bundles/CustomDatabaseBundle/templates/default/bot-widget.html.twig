{% extends '@CustomDatabase/sidebar/sidebar.html.twig' %}

{% block headscripts %}
    {{ parent() }}
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}

{% block content %}
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
<div id="ai-orb-container">
    <div id="ai-orb">
        <div class="pulse"></div>
        <div class="wave"></div>
        <div class="neural-node node-1"></div>
        <div class="neural-node node-2"></div>
        <div class="neural-node node-3"></div>
        <div class="neural-node node-4"></div>
    </div>
    
    <div id="ai-structure">
        <div class="structure-header">
            <i class="fas fa-brain"></i>
            <h3>Neural Network Active</h3>
            <div class="close-btn">&times;</div>
        </div>
        <div class="structure-content">
            <div class="neural-layer">
                <div class="layer-name">Input Layer</div>
                <div class="neurons">
                    <div class="neuron"></div>
                    <div class="neuron"></div>
                    <div class="neuron"></div>
                </div>
            </div>
            <div class="neural-connectors"></div>
            <div class="neural-layer">
                <div class="layer-name">Hidden Layer 1</div>
                <div class="neurons">
                    <div class="neuron"></div>
                    <div class="neuron"></div>
                    <div class="neuron"></div>
                    <div class="neuron"></div>
                </div>
            </div>
            <div class="neural-connectors"></div>
            <div class="neural-layer">
                <div class="layer-name">Hidden Layer 2</div>
                <div class="neurons">
                    <div class="neuron"></div>
                    <div class="neuron"></div>
                    <div class="neuron"></div>
                </div>
            </div>
            <div class="neural-connectors"></div>
            <div class="neural-layer">
                <div class="layer-name">Output Layer</div>
                <div class="neurons">
                    <div class="neuron"></div>
                </div>
            </div>
        </div>
        <div class="structure-footer">
            <div class="processing-animation">
                <span></span>
                <span></span>
                <span></span>
            </div>
            <div class="status-text">Processing neural patterns...</div>
        </div>
    </div>
</div>

<style>
/* Container - movable & centered */
#ai-orb-container {
    position: fixed;
    bottom: 60px;
    right: 60px;
    width: 80px;
    height: 80px;
    cursor: grab;
    z-index: 9999;
}

/* Orb core */
#ai-orb {
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 30% 30%, rgba(106, 90, 205, 0.8), rgba(30, 30, 47, 0.7), rgba(0, 0, 0, 0.6));
    border-radius: 50%;
    box-shadow: 0 0 40px rgba(106,90,205,0.8),
                0 0 80px rgba(79,70,229,0.5);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: float 4s ease-in-out infinite;
    backdrop-filter: blur(5px);
    border: 1px solid rgba(255, 255, 255, 0.1);
}

/* Neural glow pulse */
#ai-orb .pulse {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(106,90,205,0.3), transparent);
    animation: pulse 3s infinite ease-in-out;
}

/* Talking wave effect */
#ai-orb .wave {
    position: absolute;
    width: 80%;
    height: 80%;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.2);
    animation: wave 2s infinite ease-in-out;
}

/* Neural nodes */
.neural-node {
    position: absolute;
    width: 8px;
    height: 8px;
    background: rgba(0, 219, 222, 0.8);
    border-radius: 50%;
    box-shadow: 0 0 10px #00dbde;
}

.node-1 { top: 20%; left: 30%; }
.node-2 { top: 40%; right: 20%; }
.node-3 { bottom: 30%; left: 25%; }
.node-4 { bottom: 20%; right: 30%; }

/* AI Structure */
#ai-structure {
    position: absolute;
    bottom: 100px;
    right: 0;
    width: 300px;
    background: rgba(30, 30, 47, 0.95);
    border-radius: 15px;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    display: none;
    overflow: hidden;
    z-index: 10000;
}

.structure-header {
    padding: 15px;
    background: rgba(0, 0, 0, 0.2);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    gap: 10px;
    color: #8a2be2;
}

.structure-header h3 {
    margin: 0;
    font-size: 1.1rem;
    flex: 1;
}

.close-btn {
    cursor: pointer;
    font-size: 1.5rem;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: background 0.3s;
}

.close-btn:hover {
    background: rgba(255, 255, 255, 0.1);
}

.structure-content {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.neural-layer {
    display: flex;
    align-items: center;
    gap: 15px;
}

.layer-name {
    width: 100px;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.7);
}

.neurons {
    display: flex;
    gap: 10px;
    flex: 1;
}

.neuron {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgba(106, 90, 205, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 0 5px rgba(106, 90, 205, 0.5);
    animation: pulse 2s infinite ease-in-out;
}

.neural-connectors {
    height: 20px;
    margin: 0 0 0 100px;
    position: relative;
}

.neural-connectors::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(0, 219, 222, 0.3), transparent);
}

.structure-footer {
    padding: 15px;
    background: rgba(0, 0, 0, 0.2);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    gap: 10px;
}

.processing-animation {
    display: flex;
    gap: 3px;
}

.processing-animation span {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #00dbde;
    animation: processing 1.4s infinite ease-in-out both;
}

.processing-animation span:nth-child(1) { animation-delay: -0.32s; }
.processing-animation span:nth-child(2) { animation-delay: -0.16s; }

.status-text {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.7);
}

/* Animations */
@keyframes float {
    0%, 100% { transform: translateY(0px) scale(1); }
    50% { transform: translateY(-10px) scale(1.05); }
}

@keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 0.6; }
    50% { transform: scale(1.1); opacity: 0.8; }
}

@keyframes wave {
    0% { transform: scale(1); opacity: 0.4; }
    100% { transform: scale(1.5); opacity: 0; }
}

@keyframes processing {
    0%, 80%, 100% { transform: scale(0.8); opacity: 0.5; }
    40% { transform: scale(1.2); opacity: 1; }
}

/* Movement styles */
.dragging {
    cursor: grabbing !important;
}

</style>

<script>
$(document).ready(function() {
    const aiOrbContainer = $('#ai-orb-container');
    const aiOrb = $('#ai-orb');
    const aiStructure = $('#ai-structure');
    const closeBtn = $('.close-btn');
    
    let isDragging = false;
    let currentX, currentY, initialX, initialY, xOffset = 0, yOffset = 0;
    
    // Toggle AI structure on orb click
    aiOrb.on('click', function(e) {
        if (!isDragging) {
            aiStructure.toggle();
            if (aiStructure.is(':visible')) {
                activateNeuralNetwork();
            }
        }
    });
    
    // Close structure
    closeBtn.on('click', function(e) {
        e.stopPropagation();
        aiStructure.hide();
    });
    
    // Make AI orb draggable
    aiOrbContainer.on('mousedown', function(e) {
        e.preventDefault();
        initialX = e.clientX - xOffset;
        initialY = e.clientY - yOffset;
        
        if ($(e.target).closest('#ai-orb').length) {
            isDragging = true;
            aiOrbContainer.addClass('dragging');
        }
    });
    
    $(document).on('mouseup', function() {
        if (isDragging) {
            isDragging = false;
            aiOrbContainer.removeClass('dragging');
            initialX = currentX;
            initialY = currentY;
        }
    });
    
    $(document).on('mousemove', function(e) {
        if (isDragging) {
            e.preventDefault();
            
            currentX = e.clientX - initialX;
            currentY = e.clientY - initialY;
            
            xOffset = currentX;
            yOffset = currentY;
            
            setTranslate(currentX, currentY, aiOrbContainer[0]);
        }
    });
    
    function setTranslate(xPos, yPos, el) {
        el.style.transform = "translate3d(" + xPos + "px, " + yPos + "px, 0)";
    }
    
    function activateNeuralNetwork() {
        // Simulate neural network activity
        $('.neuron').css('animation', 'none');
        setTimeout(function() {
            $('.neuron').css('animation', 'pulse 2s infinite ease-in-out');
        }, 10);
        
        // Animate processing status
        let statusText = [
            "Processing neural patterns...",
            "Analyzing data structures...",
            "Optimizing connections...",
            "Neural network active"
        ];
        
        let currentIndex = 0;
        const statusElement = $('.status-text');
        
        const interval = setInterval(function() {
            statusElement.fadeOut(200, function() {
                statusElement.text(statusText[currentIndex]);
                statusElement.fadeIn(200);
            });
            
            currentIndex++;
            if (currentIndex >= statusText.length) {
                clearInterval(interval);
            }
        }, 1500);
    }
    
    // Touch support for mobile devices
    aiOrbContainer.on('touchstart', function(e) {
        e.preventDefault();
        const touch = e.originalEvent.touches[0];
        initialX = touch.clientX - xOffset;
        initialY = touch.clientY - yOffset;
        
        isDragging = true;
        aiOrbContainer.addClass('dragging');
    });
    
    $(document).on('touchend', function() {
        if (isDragging) {
            isDragging = false;
            aiOrbContainer.removeClass('dragging');
            initialX = currentX;
            initialY = currentY;
        }
    });
    
    $(document).on('touchmove', function(e) {
        if (isDragging) {
            e.preventDefault();
            const touch = e.originalEvent.touches[0];
            
            currentX = touch.clientX - initialX;
            currentY = touch.clientY - initialY;
            
            xOffset = currentX;
            yOffset = currentY;
            
            setTranslate(currentX, currentY, aiOrbContainer[0]);
        }
    });
});
</script>
{% endblock %}