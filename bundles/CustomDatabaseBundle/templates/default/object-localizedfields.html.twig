<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Database Connection Localized Fields</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flag-icons/css/flag-icons.min.css">

    <style>
        body {
            background-color: #f6f6f6;
            font-family: 'Open Sans', 'Helvetica Neue', helvetica, arial, verdana, sans-serif;
            font-size: 13px;
            font-weight: 300;
            color: #404040;
            line-height: 17px;
            -webkit-font-smoothing: antialiased;
            padding: 20px;
        }
        
        .container {
            max-width: 1200px;
        }
        
        /* ExtJS-style panel */
        .extjs-panel {
            border: 1px solid #d0d0d0;
            background: #f6f6f6;
            border-radius: 3px;
            margin-bottom: 20px;
            overflow: hidden;
        }
        
        .extjs-panel-body {
            padding: 10px;
            background: white;
        }
        
        /* ExtJS-style tabs */
        .extjs-tab-bar {
            display: flex;
            background: linear-gradient(to bottom, #f0f0f0, #e0e0e0);
            border-bottom: 1px solid #d0d0d0;
            height: 35px;
        }
        
        .extjs-tab {
            padding: 8px 16px;
            border: 1px solid transparent;
            border-bottom: none;
            background: transparent;
            cursor: pointer;
            position: relative;
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            color: #404040;
            transition: all 0.2s;
        }
        
        .extjs-tab:hover {
            background: rgba(255, 255, 255, 0.5);
        }
        
        .extjs-tab.active {
            background: white;
            border-color: #d0d0d0;
            border-radius: 3px 3px 0 0;
            color: #404040;
            font-weight: 500;
        }
        
        .extjs-tab.active::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 0;
            right: 0;
            height: 1px;
            background: white;
        }
        
        .extjs-tab-icon {
            width: 16px;
            height: 16px;
            display: inline-block;
            background-size: contain;
            background-repeat: no-repeat;
        }
        
        /* ExtJS-style form fields */
        .extjs-form-item {
            display: flex;
            margin-bottom: 12px;
            width: 350px;
        }
        
        .extjs-form-label {
            width: 105px;
            padding-right: 5px;
            font-weight: 500;
            color: #404040;
            display: flex;
            align-items: center;
        }
        
        .extjs-form-body {
            flex: 1;
        }
        
        .extjs-text-field {
            width: 100%;
            padding: 6px 8px;
            border: 1px solid #c0c0c0;
            border-radius: 3px;
            font-size: 13px;
            background: white;
            transition: border-color 0.2s;
        }
        
        .extjs-text-field:focus {
            outline: none;
            border-color: #4d90fe;
            box-shadow: 0 0 3px rgba(77, 144, 254, 0.5);
        }
        
        .extjs-textarea {
            min-height: 80px;
            resize: vertical;
        }
        
        /* Content panels */
        .language-content {
            display: none;
            padding: 15px 0;
        }
        
        .language-content.active {
            display: block;
        }
    </style>
</head>
<body>
   
    {% set object = objects|first %} {# get only the first object #}
    <!-- Description Field Panel -->
    <div class="extjs-form-item">
        <label class="extjs-form-label">Description:</label>
        <div class="extjs-form-body">
            <textarea class="extjs-text-field extjs-textarea" id="description-field">{{ object.description }}</textarea>
        </div>
    </div>

    <!-- Localized Fields Panel -->
    <div class="extjs-panel">
        <!-- Tab Bar -->
        <div class="extjs-tab-bar">
            {% for lang in languages %}
                {% set flag = lang == 'en' ? 'gb' : lang %}
                <div class="extjs-tab {% if loop.first %}active{% endif %}" data-language="{{ lang }}">
                    <span class="fi fi-{{ flag }}"></span>
                    <span class="extjs-tab-text">{{ lang|capitalize }}</span>
                </div>
            {% endfor %}
        </div>

        <!-- Tab Content -->
        <div class="extjs-panel-body">
            {% for lang in languages %}
                <div class="language-content {% if loop.first %}active{% endif %}" id="content-{{ lang }}">
                    <div class="extjs-form-item">
                        <label class="extjs-form-label">Data Description:</label>
                        <div class="extjs-form-body">
                            <textarea class="extjs-text-field extjs-textarea localized-field" data-language="{{ lang }}" data-field="dataDescription">{{ object.localizedFields[lang].dataDescription }}</textarea>
                        </div>
                    </div>
                    <div class="extjs-form-item">
                        <label class="extjs-form-label">Sort Description:</label>
                        <div class="extjs-form-body">
                            <textarea class="extjs-text-field extjs-textarea localized-field" data-language="{{ lang }}" data-field="sortDescription">{{ object.localizedFields[lang].sortDescription }}</textarea>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    <!-- Save Button -->
    <div class="text-center mt-3">
        <button class="btn btn-primary btn-lg" id="save-all-btn">Save</button>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const tabs = document.querySelectorAll('.extjs-tab');

            tabs.forEach(tab => {
                tab.addEventListener('click', function() {
                    // Remove active class from all tabs and content
                    tabs.forEach(t => t.classList.remove('active'));
                    document.querySelectorAll('.language-content').forEach(content => {
                        content.classList.remove('active');
                    });

                    // Add active class to clicked tab
                    this.classList.add('active');

                    // Show corresponding content
                    const language = this.getAttribute('data-language');
                    document.getElementById(`content-${language}`).classList.add('active');
                });
            });

            // Save all fields functionality
            const saveBtn = document.getElementById('save-all-btn');

            saveBtn.addEventListener('click', function() {
                const objectId = {{ object.id }};
                const description = document.getElementById('description-field').value;

                // Collect localized fields
                const localizedFields = {};
                const localizedFieldElements = document.querySelectorAll('.localized-field');

                localizedFieldElements.forEach(field => {
                    const lang = field.getAttribute('data-language');
                    const fieldName = field.getAttribute('data-field');
                    const value = field.value;

                    if (!localizedFields[lang]) {
                        localizedFields[lang] = {};
                    }
                    localizedFields[lang][fieldName] = value;
                });

                fetch('/update-all-fields', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        id: objectId,
                        description: description,
                        localizedFields: localizedFields
                    })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('All fields saved successfully!');
                    } else {
                        alert('Error saving fields: ' + data.message);
                    }
                })
                .catch(error => {
                    alert('Error: ' + error.message);
                });
            });
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

